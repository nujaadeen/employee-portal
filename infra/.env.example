# Copy to infra/.env and fill in. Never commit infra/.env.
# Social sign-in (leave the placeholders if you do not test that provider)
GOOGLE_CLIENT_ID=change-me
GOOGLE_CLIENT_SECRET=change-me
GITHUB_CLIENT_ID=change-me
GITHUB_CLIENT_SECRET=change-me
FACEBOOK_CLIENT_ID=change-me
FACEBOOK_CLIENT_SECRET=change-me

# Keycloak bootstrap admin (master realm)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-admin

# Secret of the confidential client portal-service (Spring uses it for the Admin API)
PORTAL_SERVICE_CLIENT_SECRET=change-me-service-secret

# Secret of the Keycloak client "gitea" (single sign-on into Gitea)
GITEA_OIDC_CLIENT_SECRET=change-me-gitea-oidc-secret

# Gitea API token (create in Gitea: Settings > Applications) and webhook HMAC secret
GITEA_TOKEN=change-me-gitea-token
GITEA_WEBHOOK_SECRET=change-me-webhook-secret

# Optional overrides
POSTGRES_PASSWORD=postgres

# ---- AI service (Phase 2) ----
# Secret of the Keycloak client portal-backend-ai (Spring gets service tokens for the AI service with it)
PORTAL_BACKEND_AI_CLIENT_SECRET=change-me-backend-ai-secret

# Chat model. ollama (default), openai_compatible (any OpenAI-style API) or fake (canned answers, for tests)
AI_LLM_PROVIDER=ollama
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
# Only for AI_LLM_PROVIDER=openai_compatible
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# Embeddings and vector store
EMBEDDING_MODEL=BAAI/bge-m3
CHROMA_URL=http://chroma:8000

# Google Drive: path of a service account key INSIDE the container, and where the file is on your machine.
# Share the Drive folder with the service account's e-mail address. Leave empty to disable Drive.
GOOGLE_SA_KEY_PATH=
GOOGLE_SA_KEY_HOST_PATH=

# Largest PDF accepted by the upload endpoint
AI_MAX_UPLOAD_MB=25
